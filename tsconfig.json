// Map table key -> display label for FK lookups in the table
export function resolveFK(tableKey: string, id: number, db: any): string {
  if (id === undefined || id === null) return '';
  switch (tableKey) {
    case 'coach_id': {
      const r = db.coaches.find((c: any) => c.id === id);
      return r ? r.name : String(id);
    }
    case 'team_id': case 'home_team_id': case 'away_team_id': case 'favorite_team_id': {
      const r = db.teams.find((t: any) => t.id === id);
      return r ? r.name : String(id);
    }
    case 'player_id': {
      const r = db.players.find((p: any) => p.id === id);
      return r ? r.name : String(id);
    }
    case 'venue_id': {
      const r = db.venues.find((v: any) => v.id === id);
      return r ? r.name : String(id);
    }
    case 'season_id': {
      const r = db.seasons.find((s: any) => s.id === id);
      return r ? r.name : String(id);
    }
    case 'match_id': {
      const r = db.matches.find((m: any) => m.id === id);
      if (r) {
        const h = db.teams.find((t: any) => t.id === r.home_team_id);
        const a = db.teams.find((t: any) => t.id === r.away_team_id);
        return h && a ? `${h.name} vs ${a.name}` : String(id);
      }
      return String(id);
    }
    case 'schedule_id': {
      const r = db.schedules.find((s: any) => s.id === id);
      return r ? `#${r.id} — ${r.match_date}` : String(id);
    }
    default: return String(id);
  }
}
