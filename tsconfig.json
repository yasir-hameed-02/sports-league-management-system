import { FieldDef } from './store';

export interface ModuleDef {
  key: string;          // table key
  label: string;        // display name
  icon: string;         // emoji icon (unique per module)
  singular: string;     // singular name for modals
  fields: FieldDef[];
  columns: { key: string; label: string; width?: string }[];
}

// Helper to generate options from DB rows
function optsFromTable(rows: any[], idKey = 'id', labelKey = 'name') {
  return rows.map(r => ({ value: r[idKey], label: r[labelKey] }));
}

